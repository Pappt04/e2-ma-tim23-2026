rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }

    // Users: readable by any authenticated user; star/token/league fields are not client-writable
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['stars', 'totalStarsEarned', 'tokens', 'leagueLevel']);
    }

    // Username uniqueness index — public read so pre-auth uniqueness checks work
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuth() &&
        isOwner(request.resource.data.uid) &&
        !exists(/databases/$(database)/documents/usernames/$(username));
      allow delete, update: if false;
    }

    // Matches: any authenticated user can create; participants can update
    match /matches/{matchId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.player1Id == request.auth.uid ||
        resource.data.player2Id == request.auth.uid
      );
      allow delete: if isAuth() && resource.data.player1Id == request.auth.uid &&
        resource.data.status == 'WAITING_FOR_OPPONENT';

      match /gameResults/{gameType} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
    }

    // Match invites: inviter can create; inviter or invitee can update (cancel/respond)
    match /matchInvites/{inviteId} {
      allow read: if isAuth() && (
        resource.data.inviterId == request.auth.uid ||
        resource.data.inviteeId == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.inviterId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.inviterId == request.auth.uid ||
        resource.data.inviteeId == request.auth.uid
      );
    }

    // Challenges: readable by any authenticated user
    match /challenges/{challengeId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuth();

      match /participants/{uid} {
        allow read: if isAuth();
        allow create: if isAuth() && isOwner(uid);
        allow update: if isAuth() && isOwner(uid);

        match /gameResults/{gameType} {
          allow read: if isAuth();
          allow create: if isAuth() && isOwner(uid) &&
            !exists(/databases/$(database)/documents/challenges/$(challengeId)/participants/$(uid)/gameResults/$(gameType));
          allow update, delete: if false;
        }
      }
    }

    // Chat: authenticated users can create messages; no edit/delete
    match /chat/{region}/messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.content.size() <= 1000;
      allow update, delete: if false;
    }

    // Questions: read-only for authenticated users
    match /korakPoKorakQuestions/{questionId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /leaderboards/{document} {
      allow read: if isAuth();
      allow write: if false;
    }
  }
}
